{
  "name": "highfield",
  "private": true,
  "version": "0.1.0",
  "description": "Highfield, a browser estate sim forked from llm-world's apps/estate: TypeScript engine, IndexedDB saves, no server and no model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yakovkhalinsky/highfield"
  },
  "homepage": "https://yakov.khalinsky.com/highfield/",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "reference": "sh scripts/reference.sh",
    "pretest": "sh scripts/reference.sh",
    "test": "vitest run",
    "rules": "sh scripts/reference.sh && \"${PYTHON:-python3}\" \"${LLM_WORLD:-.reference/llm-world}/apps/estate/tools/export_rules.py\" > src/sim/rules.json.tmp && mv src/sim/rules.json.tmp src/sim/rules.json",
    "sync:page3d": "sh scripts/reference.sh && tsx scripts/sync-page3d.ts",
    "parity": "sh scripts/reference.sh && tsx scripts/parity.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
